<Window x:Class="learning_wpf_opencv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OpenCV WPF Viewer"
        Height="600"
        Width="800"
        MinHeight="600"
        MinWidth="800">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Width="96"
                    Height="30"
                    Margin="0,0,8,0"
                    Command="{Binding OpenFileCommand}"
                    Content="Open File"/>

            <TextBox Grid.Column="1"
                     Height="30"
                     VerticalContentAlignment="Center"
                     IsReadOnly="True"
                     Text="{Binding OpenedFilePath, Mode=OneWay}"/>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0"
                   Grid.Column="0"
                   Padding="0,0,0,6"
                   FontWeight="SemiBold"
                   Content="Original"/>

            <Label Grid.Row="0"
                   Grid.Column="2"
                   Padding="0,0,0,6"
                   FontWeight="SemiBold"
                   Content="Result"/>

            <Border Grid.Row="1"
                    Grid.Column="0"
                    BorderBrush="#C8C8C8"
                    BorderThickness="1"
                    Background="#F7F7F7">
                <Image Source="{Binding OpenedImage}"
                       Stretch="Uniform"/>
            </Border>

            <Border Grid.Row="1"
                    Grid.Column="2"
                    BorderBrush="#C8C8C8"
                    BorderThickness="1"
                    Background="#F7F7F7">
                <Image Source="{Binding DisplayingImage}"
                       Stretch="Uniform"/>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left">
            <Button Width="96"
                    Height="30"
                    Margin="0,0,8,0"
                    Command="{Binding SmoothCommand}"
                    Content="Smooth"/>

            <Button Width="140"
                    Height="30"
                    Command="{Binding SuperResolutionCommand}"
                    Content="Super Resolution"/>
        </StackPanel>
    </Grid>
</Window>
